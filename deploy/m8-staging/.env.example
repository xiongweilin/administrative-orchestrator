# Isolated M8 staging only. Do not use these development defaults for production.
# Copy this file to a local env file if you need an explicit override; keep
# real/changed values and all credential material out of Git.

POSTGRES_USER=administrative_m8
POSTGRES_PASSWORD=m8-admin-postgres-password
POSTGRES_DB=administrative_m8
AGENT_KERNEL_REF=0bb90afa4cf8517018e3e5b3715da12d28908c79

ADMIN_OIDC_ISSUER=http://127.0.0.1:18103/realms/m8
ADMIN_OIDC_AUDIENCE=administrative-operations-console
ADMIN_OIDC_ALLOW_INSECURE_HTTP=true
ADMIN_OPERATIONS_OIDC_CLIENT_ID=administrative-operations-console
ADMIN_OPERATIONS_OIDC_SCOPE=openid

ADMIN_ODOO_BASE_URL=http://odoo:8069
ADMIN_ODOO_DATABASE=m8_odoo
ADMIN_ODOO_READER_USERNAME=administrative-reader
ADMIN_ODOO_READER_SECRET=m8-odoo-reader-secret
ADMIN_ODOO_WRITER_USERNAME=administrative-kernel-writer
ADMIN_ODOO_WRITER_SECRET=m8-odoo-writer-secret
ADMIN_ODOO_VERIFIER_USERNAME=administrative-kernel-verifier
ADMIN_ODOO_VERIFIER_SECRET=m8-odoo-verifier-secret
ADMIN_ODOO_FINANCIAL_WRITER_USERNAME=administrative-kernel-writer
ADMIN_ODOO_FINANCIAL_WRITER_SECRET=m8-odoo-writer-secret
ADMIN_ODOO_FINANCIAL_VERIFIER_USERNAME=administrative-kernel-verifier
ADMIN_ODOO_FINANCIAL_VERIFIER_SECRET=m8-odoo-verifier-secret
ADMIN_ODOO_REQUEST_REF_FIELD=x_administrative_request_ref
ADMIN_ODOO_DEACTIVATE_REQUEST_REF_FIELD=x_administrative_deactivate_request_ref
ADMIN_ODOO_PRINCIPAL_ID_FIELD=x_administrative_principal_id
ADMIN_ODOO_TERMINATION_STATUS_FIELD=x_administrative_termination_status
ADMIN_ODOO_TERMINATION_EFFECTIVE_AT_FIELD=x_administrative_termination_effective_at
ADMIN_ODOO_EMPLOYMENT_EPISODE_FIELD=x_administrative_employment_episode_ref
ADMIN_ODOO_TRANSACTION_REQUEST_REF_FIELD=x_administrative_transaction_request_ref
ADMIN_ODOO_TRANSACTION_CONFIRM_REQUEST_REF_FIELD=x_administrative_transaction_confirm_request_ref
ADMIN_ODOO_TRANSACTION_SUBJECT_REF_FIELD=x_administrative_transaction_subject_ref

ADMIN_KEYCLOAK_BASE_URL=http://keycloak:8080
ADMIN_KEYCLOAK_REALM=m8
ADMIN_KEYCLOAK_READER_CLIENT_ID=administrative-reader
ADMIN_KEYCLOAK_READER_SECRET=m8-keycloak-reader-secret
ADMIN_KEYCLOAK_WRITER_CLIENT_ID=administrative-kernel-writer
ADMIN_KEYCLOAK_WRITER_SECRET=m8-keycloak-writer-secret
ADMIN_KEYCLOAK_VERIFIER_CLIENT_ID=administrative-kernel-verifier
ADMIN_KEYCLOAK_VERIFIER_SECRET=m8-keycloak-verifier-secret
ADMIN_KEYCLOAK_REQUEST_REF_ATTRIBUTE=administrative_request_ref

KEYCLOAK_ADMIN=m8-admin
KEYCLOAK_ADMIN_PASSWORD=m8-keycloak-admin-password
KEYCLOAK_HOSTNAME=http://127.0.0.1:18103
KEYCLOAK_PORT=18105
ODOO_POSTGRES_USER=odoo
ODOO_POSTGRES_PASSWORD=m8-odoo-postgres-password
ODOO_PORT=18104

# The worker reads these files from the existing external feishu_secrets volume.
ADMIN_FEISHU_APP_ID_FILE=/run/feishu-secrets/feishu_app_id
ADMIN_FEISHU_APP_SECRET_FILE=/run/feishu-secrets/feishu_app_secret
ADMIN_FEISHU_BASE_URL=https://open.feishu.cn
ADMIN_FEISHU_ENCRYPT_KEY=
ADMIN_FEISHU_ACCESS_TOKEN=
ADMIN_FEISHU_VERIFICATION_TOKEN=
ADMIN_FEISHU_VERIFICATION_TOKEN_FILE=
ADMIN_FEISHU_INGRESS_SHARED_SECRET=
ADMIN_FEISHU_INGRESS_SHARED_SECRET_FILE=/run/feishu-secrets/administrative_ingress_shared_secret

# Current host LiteLLM endpoint. Do not restart the host LiteLLM processes.
ADMIN_INTAKE_MODEL_URL=http://host.docker.internal:4100/v1
ADMIN_INTAKE_MODEL_PROTOCOL=openai-responses
ADMIN_INTAKE_MODEL_NAME=opencode-go/deepseek-flash
ADMIN_INTAKE_MODEL_MAX_TOKENS=6000
ADMIN_INTAKE_MODEL_API_KEY=
ADMIN_INTAKE_MODEL_PROFILE_REF=feishu-m8-document-v1
ADMIN_INTAKE_MODEL_SCHEMA_REF=candidate-interpretation-v1

ADMIN_API_PORT=18101
ADMIN_OPERATIONS_API_PORT=18102
ADMIN_OPERATIONS_CONSOLE_PORT=18103
ADMIN_WORKER_POLL_SECONDS=1
